{% extends 'base.html.twig' %}

{% block title %}
    Jaoua Ollivier — Développeur Web & Applications
{% endblock %}

{% block body %}

    <section id="hero" class="hero">
        <div class="container hero-grid">

            <div class="hero-content">
                <h1>
                    Jaoua Ollivier<br>
                    <span>Développeur web & applications</span>
                </h1>

                <p class="hero-status">
                    Recherche d'une alternance CDA à Nantes et ses environs.
                </p>

                <div class="hero-actions">
                    <a href="#projects" class="button button-primary">
                        Voir mes projets
                    </a>

                    <a href="https://github.com/JaouaO"
                       class="button button-secondary"
                       target="_blank"
                       rel="noopener">
                        GitHub
                    </a>
                </div>
            </div>

            <aside class="hero-profile">
                <div class="hero-photo">
                    <img src="{{ asset('images/jaoua-pp.jpg') }}"
                         alt="Portrait de Jaoua Ollivier">
                </div>

                <p>
                    Développeur web orienté applications, j'aime concevoir des projets
                    complets, du backend à l'interface, avec une attention particulière
                    portée à la lisibilité et à la maintenabilité du code.
                </p>
            </aside>

        </div>
    </section>


    <section id="projects" class="section reveal">
        <div class="container">

            <header class="section-header">
                <p class="section-number">01</p>

                <div>
                    <p class="eyebrow">Sélection</p>
                    <h2>Mes projets</h2>
                </div>
            </header>

            <div class="projects-grid">

                <article class="project-card">
                    <div class="project-number">01</div>

                    <div class="project-content">
                        <p class="project-type">
                            Expérience professionnelle
                        </p>

                        <h3>Maintenance Management App</h3>

                        <p>
                            Application conçue pendant mon stage chez Maintronic
                            pour faciliter la gestion des interventions de maintenance.
                        </p>

                        <ul class="tags">
                            <li>PHP</li>
                            <li>JavaScript</li>
                            <li>SQL</li>
                        </ul>

                        <a href="https://github.com/JaouaO/maintenance-management-app"
                           target="_blank"
                           rel="noopener"
                           class="project-link">
                            Voir sur GitHub →
                        </a>
                    </div>
                </article>


                <article class="project-card">
                    <div class="project-number">02</div>

                    <div class="project-content">
                        <p class="project-type">
                            Projet Symfony
                        </p>

                        <h3>Sortir</h3>

                        <p>
                            Application permettant d'organiser et de gérer
                            des sorties entre utilisateurs.
                        </p>

                        <ul class="tags">
                            <li>PHP</li>
                            <li>Symfony</li>
                            <li>SQL</li>
                        </ul>

                        <a href="https://github.com/JaouaO/sortir-symfony"
                           target="_blank"
                           rel="noopener"
                           class="project-link">
                            Voir sur GitHub →
                        </a>
                    </div>
                </article>


                <article class="project-card">
                    <div class="project-number">03</div>

                    <div class="project-content">
                        <p class="project-type">
                            Projet Java
                        </p>

                        <h3>Auction Platform</h3>

                        <p>
                            Plateforme web de ventes aux enchères développée
                            avec Spring Boot et Thymeleaf.
                        </p>

                        <ul class="tags">
                            <li>Java</li>
                            <li>Spring Boot</li>
                            <li>Thymeleaf</li>
                            <li>SQL</li>
                        </ul>

                        <a href="https://github.com/JaouaO/auction-platform"
                           target="_blank"
                           rel="noopener"
                           class="project-link">
                            Voir sur GitHub →
                        </a>
                    </div>
                </article>

            </div>

        </div>
    </section>


    <section id="about" class="section section-alt reveal">
        <div class="container about-grid">

            <div>
                <p class="eyebrow">À propos</p>

                <h2>
                    Développer des applications utiles,
                    lisibles et maintenables.
                </h2>
            </div>

            <div class="about-text">
                <p>
                    Titulaire du titre Développeur Web et Web Mobile,
                    je poursuis aujourd'hui ma formation avec le titre
                    Concepteur Développeur d'Applications.
                </p>

                <p>
                    J'aime comprendre le fonctionnement d'une application
                    dans son ensemble : conception, développement,
                    base de données, interface et déploiement.
                </p>

                <p>
                    Je recherche une entreprise dans laquelle je pourrai
                    continuer à progresser tout en participant à de vrais projets.
                </p>
            </div>

        </div>
    </section>


    <section id="skills" class="section reveal">
        <div class="container">

            <header class="section-header">
                <p class="section-number">02</p>

                <div>
                    <p class="eyebrow">Technologies</p>
                    <h2>Compétences</h2>
                </div>
            </header>

            <div class="skills-grid">

                <article class="skill-block">
                    <p>Backend</p>
                    <h3>PHP</h3>
                    <h3>Symfony</h3>
                    <h3>Java</h3>
                    <h3>Spring Boot</h3>
                </article>

                <article class="skill-block">
                    <p>Frontend</p>
                    <h3>JavaScript</h3>
                    <h3>TypeScript</h3>
                    <h3>Angular</h3>
                    <h3>HTML / CSS</h3>
                </article>

                <article class="skill-block">
                    <p>Données</p>
                    <h3>SQL</h3>
                    <h3>MySQL</h3>
                    <h3>MongoDB</h3>
                </article>

                <article class="skill-block">
                    <p>Outils</p>
                    <h3>Git</h3>
                    <h3>Docker</h3>
                    <h3>PhpStorm</h3>
                    <h3>IntelliJ</h3>
                </article>

            </div>

        </div>
    </section>


    <section id="experience" class="section section-alt reveal">
        <div class="container">

            <header class="section-header">
                <p class="section-number">03</p>

                <div>
                    <p class="eyebrow">Parcours</p>
                    <h2>Expérience</h2>
                </div>
            </header>

            <div class="timeline">

                <article class="experience-item">
                    <div class="experience-date">
                        2025
                    </div>

                    <div>
                        <h3>Maintronic</h3>

                        <p class="experience-role">
                            Développeur — Stage
                        </p>

                        <p>
                            Conception et développement d'une application
                            de gestion des appels d'intervention de maintenance,
                            avec notamment une carte interactive pour la planification.
                        </p>
                    </div>
                </article>

                <article class="experience-item">
                    <div class="experience-date">
                        2024
                    </div>

                    <div>
                        <h3>CRNA Ouest</h3>

                        <p class="experience-role">
                            Immersion professionnelle
                        </p>

                        <p>
                            Participation au développement d'une interface
                            de connexion utilisant Python, HTML, CSS,
                            JavaScript et Git.
                        </p>
                    </div>
                </article>

            </div>

        </div>
    </section>


    <section id="contact" class="contact reveal">
        <div class="container contact-inner">

            <p class="eyebrow">
                Une opportunité ?
            </p>

            <h2>
                Travaillons ensemble.
            </h2>

            <p>
                Je recherche actuellement une alternance en développement
                d'applications à Nantes et ses environs.
            </p>

            <div class="contact-links">
                <a href="mailto:jaoua.o@gmail.com" class="button button-primary">
                    Me contacter
                </a>

                <a href="https://github.com/JaouaO"
                   target="_blank"
                   rel="noopener"
                   class="button button-secondary">
                    GitHub
                </a>
            </div>

        </div>
    </section>

{% endblock %}
