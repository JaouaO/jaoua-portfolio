<pre><code>#[ORM\ManyToMany(
    targetEntity: User::class,
    mappedBy: 'registeredEvents'
)]
private Collection $registeredParticipants;

#[ORM\ManyToOne(
    inversedBy: 'organizedEvents'
)]
#[ORM\JoinColumn(
    nullable: false,
    onDelete: "CASCADE"
)]
private ?User $organizer = null;</code></pre>
